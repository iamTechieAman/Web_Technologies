# Compiler Visualizer — Environment Variables
# Copy this file to .env.local and fill in your values

# Judge0 CE Public API (free, no key needed for basic usage)
JUDGE0_API_URL=https://ce.judge0.com

# OpenRouter API Key (for AI explain/debug features)
# Get yours at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=openrouter/free

# Clerk Auth (free tier works for local login/signup)
# Get yours from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here

# Anthropic Claude API Key (optional, for AI explain/debug features)
# Get yours at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_key_here

# App URL (used for generating share links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
