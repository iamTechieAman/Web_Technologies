{
  "name": "codevisualizer",
  "version": "4.0.0",
  "private": true,
  "scripts": {
    "dev": "WATCHPACK_POLLING=true CHOKIDAR_USEPOLLING=1 next dev",
    "exec-server": "node server/exec-server.js",
    "dev:full": "node server/exec-server.js & WATCHPACK_POLLING=true CHOKIDAR_USEPOLLING=1 next dev",
    "build": "next build",
    "check": "npm run build",
    "start": "next start",
    "lint": "next lint",
    "fix": "eslint . --fix",
    "scrape": "node scripts/fetch-all-problems.js",
    "fix:ports": "node scripts/fix-ports.js",
    "prestart:all": "npm run fix:ports",
    "start:all": "npm run prestart:all && concurrently \"npm run exec-server\" \"npm run dev\"",
    "start:prod": "npm run build && npm run start"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.53",
